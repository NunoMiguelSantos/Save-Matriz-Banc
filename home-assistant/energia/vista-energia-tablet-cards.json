[
  {
    "type": "custom:layout-card",
    "grid_options": {
      "columns": 48,
      "rows": "auto"
    },
    "layout_type": "custom:grid-layout",
    "layout": {
      "grid-template-columns": "118px minmax(0, 1fr)",
      "grid-template-areas": "\"back title\"",
      "grid-column-gap": "12px",
      "align-items": "stretch",
      "margin": 0,
      "mediaquery": {
        "(max-width: 850px)": {
          "grid-template-columns": "88px minmax(0, 1fr)"
        }
      }
    },
    "cards": [
      {
        "type": "custom:button-card",
        "name": "Casa",
        "icon": "mdi:chevron-left",
        "show_name": true,
        "show_icon": true,
        "tap_action": {
          "action": "navigate",
          "navigation_path": "novo-tablet"
        },
        "hold_action": {
          "action": "none"
        },
        "view_layout": {
          "grid-area": "back"
        },
        "styles": {
          "card": [
            {
              "height": "76px"
            },
            {
              "padding": "0 14px"
            },
            {
              "border-radius": "20px"
            },
            {
              "background": "rgba(0,0,0,0.22)"
            },
            {
              "border": "1px solid rgba(255,255,255,0.14)"
            },
            {
              "box-shadow": "none"
            }
          ],
          "grid": [
            {
              "grid-template-areas": "\"i n\""
            },
            {
              "grid-template-columns": "30px 1fr"
            },
            {
              "column-gap": "7px"
            }
          ],
          "icon": [
            {
              "width": "27px"
            },
            {
              "color": "CadetBlue"
            }
          ],
          "name": [
            {
              "justify-self": "start"
            },
            {
              "font-size": "14px"
            },
            {
              "font-weight": 600
            },
            {
              "color": "rgba(255,255,255,0.88)"
            }
          ]
        }
      },
      {
        "type": "custom:button-card",
        "name": "Energia",
        "label": "Fatura, custos e equipamentos",
        "icon": "mdi:lightning-bolt",
        "show_name": true,
        "show_label": true,
        "show_icon": true,
        "tap_action": {
          "action": "none"
        },
        "view_layout": {
          "grid-area": "title"
        },
        "styles": {
          "card": [
            {
              "height": "76px"
            },
            {
              "padding": "0 20px"
            },
            {
              "border-radius": "20px"
            },
            {
              "background": "rgba(0,0,0,0.22)"
            },
            {
              "border": "1px solid rgba(255,255,255,0.14)"
            },
            {
              "box-shadow": "none"
            }
          ],
          "grid": [
            {
              "grid-template-areas": "\"i n\" \"i l\""
            },
            {
              "grid-template-columns": "52px 1fr"
            },
            {
              "grid-template-rows": "1fr 1fr"
            },
            {
              "column-gap": "12px"
            }
          ],
          "img_cell": [
            {
              "width": "44px"
            },
            {
              "height": "44px"
            },
            {
              "border-radius": "14px"
            },
            {
              "background": "rgba(95,158,160,0.15)"
            }
          ],
          "icon": [
            {
              "width": "27px"
            },
            {
              "color": "CadetBlue"
            }
          ],
          "name": [
            {
              "align-self": "end"
            },
            {
              "justify-self": "start"
            },
            {
              "font-size": "22px"
            },
            {
              "font-weight": 650
            },
            {
              "color": "white"
            }
          ],
          "label": [
            {
              "align-self": "start"
            },
            {
              "justify-self": "start"
            },
            {
              "margin-top": "3px"
            },
            {
              "font-size": "13px"
            },
            {
              "color": "rgba(255,255,255,0.58)"
            }
          ]
        }
      }
    ]
  },
  {
    "type": "custom:layout-card",
    "grid_options": {
      "columns": 48,
      "rows": "auto"
    },
    "layout_type": "custom:grid-layout",
    "layout": {
      "grid-template-columns": "repeat(3, minmax(0, 1fr))",
      "grid-template-areas": "\"c1 c2 c3\"",
      "grid-gap": "12px",
      "align-items": "start",
      "margin": 0,
      "mediaquery": {
        "(max-width: 1100px)": {
          "grid-template-columns": "repeat(2, minmax(0, 1fr))",
          "grid-template-areas": "\"c1 c2\" \"c3 c3\""
        },
        "(max-width: 700px)": {
          "grid-template-columns": "1fr",
          "grid-template-areas": "\"c1\" \"c2\" \"c3\""
        }
      }
    },
    "cards": [
      {
        "type": "vertical-stack",
        "view_layout": {
          "grid-area": "c1"
        },
        "cards": [
          {
            "type": "custom:energia-insights-card",
            "mode": "resumo",
            "title": "Fatura",
            "icon": "mdi:receipt-text-outline",
            "subtitle": "Valor a pagar com custos fixos, impostos e IVA, por ciclo de faturação (dia 22 a 22)."
          },
          {
            "type": "custom:energia-insights-card",
            "mode": "perfil",
            "title": "A que horas gastas mais",
            "icon": "mdi:clock-outline",
            "subtitle": "Média por hora nos últimos 30 dias."
          },
          {
            "type": "custom:energia-insights-card",
            "mode": "tendencia",
            "title": "Últimos 12 meses",
            "icon": "mdi:chart-bar"
          }
        ]
      },
      {
        "type": "vertical-stack",
        "view_layout": {
          "grid-area": "c2"
        },
        "cards": [
          {
            "type": "custom:energia-insights-card",
            "mode": "ranking",
            "title": "Ranking de equipamentos",
            "icon": "mdi:podium",
            "subtitle": "Só a parte variável (preço do kWh), sem custos fixos. 'Não identificado' é o que o contador geral mede e nenhum sensor explica.",
            "devices": [
              {
                "name": "Bomba de calor",
                "stat": "sensor.bomba_de_calor_energy",
                "icon": "mdi:heat-pump-outline"
              },
              {
                "name": "Frigorífico",
                "stat": "sensor.blitz_tomada_frigorifico_smartenergy_metering_summation_delivered",
                "icon": "mdi:fridge-outline"
              },
              {
                "name": "Tomadas cozinha",
                "stat": "sensor.refoss_smart_energy_monitor_tomadas_cozinha_today_energy",
                "icon": "mdi:power-socket-eu"
              },
              {
                "name": "Placa elétrica",
                "stat": "sensor.refoss_smart_energy_monitor_placa_eletrica_today_energy",
                "icon": "mdi:stove"
              },
              {
                "name": "Máq. lavar roupa",
                "stat": "sensor.refoss_smart_energy_monitor_maquina_de_lavar_roupa_today_energy",
                "icon": "mdi:washing-machine"
              },
              {
                "name": "Máq. secar roupa",
                "stat": "sensor.refoss_smart_energy_monitor_maquina_de_secar_roupa_today_energy",
                "icon": "mdi:tumble-dryer"
              },
              {
                "name": "Máq. lavar louça",
                "stat": "sensor.refoss_smart_energy_monitor_maquina_lavar_louca_today_energy",
                "icon": "mdi:dishwasher"
              },
              {
                "name": "Tomadas sala (resto)",
                "stat": "sensor.refoss_smart_energy_monitor_tomadas_sala_today_energy",
                "icon": "mdi:sofa-outline",
                "subtract": [
                  "sensor.tomada_ac_sala_summation_delivered",
                  "sensor.blitz_tomada_sala_smartenergy_metering_summation_delivered"
                ]
              },
              {
                "name": "AC Sala",
                "stat": "sensor.tomada_ac_sala_summation_delivered",
                "icon": "mdi:air-conditioner"
              },
              {
                "name": "AC Suíte",
                "stat": "sensor.tomada_ac_suite_summation_delivered",
                "icon": "mdi:air-conditioner"
              },
              {
                "name": "AC Bebé",
                "stat": "sensor.tomada_ac_bebe_summation_delivered",
                "icon": "mdi:air-conditioner"
              },
              {
                "name": "AC Escritório",
                "stat": "sensor.tomada_ac_escritorio_summation_delivered",
                "icon": "mdi:air-conditioner"
              },
              {
                "name": "Domótica",
                "stat": "sensor.blitz_tomada_sala_smartenergy_metering_summation_delivered",
                "icon": "mdi:server-network"
              },
              {
                "name": "Iluminação",
                "stat": "sensor.total_iluminacao_kwh",
                "icon": "mdi:lightbulb-group-outline"
              },
              {
                "name": "Estores",
                "stat": "sensor.total_estores_kwh",
                "icon": "mdi:blinds-horizontal"
              },
              {
                "name": "Ventilação",
                "stat": "sensor.total_ventilacao_kwh",
                "icon": "mdi:fan"
              }
            ]
          }
        ]
      },
      {
        "type": "vertical-stack",
        "view_layout": {
          "grid-area": "c3"
        },
        "cards": [
          {
            "type": "custom:energia-insights-card",
            "mode": "maquinas",
            "title": "Custo por ciclo",
            "icon": "mdi:washing-machine",
            "subtitle": "Ciclos detetados automaticamente pela potência.",
            "machines": [
              {
                "name": "Lavar roupa",
                "icon": "mdi:washing-machine",
                "stat": "sensor.refoss_smart_energy_monitor_maquina_de_lavar_roupa_today_energy",
                "power": "sensor.refoss_smart_energy_monitor_maquina_de_lavar_roupa_power",
                "ultimo": "input_number.lavar_roupa_ultimo_ciclo",
                "ciclos": "counter.lavar_roupa_ciclos_mes",
                "kwh_ciclos": "input_number.lavar_roupa_kwh_ciclos_mes",
                "em_ciclo": "input_boolean.lavar_roupa_em_ciclo"
              },
              {
                "name": "Secar roupa",
                "icon": "mdi:tumble-dryer",
                "stat": "sensor.refoss_smart_energy_monitor_maquina_de_secar_roupa_today_energy",
                "power": "sensor.refoss_smart_energy_monitor_maquina_de_secar_roupa_power",
                "ultimo": "input_number.secar_roupa_ultimo_ciclo",
                "ciclos": "counter.secar_roupa_ciclos_mes",
                "kwh_ciclos": "input_number.secar_roupa_kwh_ciclos_mes",
                "em_ciclo": "input_boolean.secar_roupa_em_ciclo"
              },
              {
                "name": "Lavar louça",
                "icon": "mdi:dishwasher",
                "stat": "sensor.refoss_smart_energy_monitor_maquina_lavar_louca_today_energy",
                "power": "sensor.refoss_smart_energy_monitor_maquina_lavar_louca_power",
                "ultimo": "input_number.lavar_louca_ultimo_ciclo",
                "ciclos": "counter.lavar_louca_ciclos_mes",
                "kwh_ciclos": "input_number.lavar_louca_kwh_ciclos_mes",
                "em_ciclo": "input_boolean.lavar_louca_em_ciclo"
              }
            ]
          },
          {
            "type": "custom:energia-insights-card",
            "mode": "ranking",
            "title": "Clima por divisão",
            "icon": "mdi:air-conditioner",
            "subtitle": "% dentro da climatização.",
            "devices": [
              {
                "name": "Bomba de calor",
                "stat": "sensor.bomba_de_calor_energy",
                "icon": "mdi:heat-pump-outline"
              },
              {
                "name": "AC Sala",
                "stat": "sensor.tomada_ac_sala_summation_delivered",
                "icon": "mdi:air-conditioner"
              },
              {
                "name": "AC Suíte",
                "stat": "sensor.tomada_ac_suite_summation_delivered",
                "icon": "mdi:air-conditioner"
              },
              {
                "name": "AC Bebé",
                "stat": "sensor.tomada_ac_bebe_summation_delivered",
                "icon": "mdi:air-conditioner"
              },
              {
                "name": "AC Escritório",
                "stat": "sensor.tomada_ac_escritorio_summation_delivered",
                "icon": "mdi:air-conditioner"
              }
            ],
            "show_unidentified": false,
            "percent_of": "grupo",
            "hint": false
          }
        ]
      }
    ]
  },
